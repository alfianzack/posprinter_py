{
  "examples": {
    "mode1_html_direct": {
      "description": "Mode 1: Kirim HTML langsung (sistem print HTML yang sudah jadi)",
      "endpoint": "POST http://localhost:7080/api/print-html",
      "request": {
        "htmlContent": "<!DOCTYPE html><html><head><meta charset=\"UTF-8\"><style>body { font-family: Arial; width: 576px; margin: 0 auto; padding: 10px; } .header { text-align: center; font-weight: bold; margin-bottom: 10px; } .item { display: flex; justify-content: space-between; margin: 5px 0; } .total { font-weight: bold; border-top: 1px solid #000; padding-top: 5px; margin-top: 10px; }</style></head><body><div class=\"header\">DXN COMPANY</div><div class=\"header\">123 Main Street</div><div class=\"header\">Phone: 123-456-7890</div><hr><div class=\"item\"><span>Order No:</span><span>ORD001</span></div><div class=\"item\"><span>Date:</span><span>2024-01-01 10:00:00</span></div><hr><div class=\"item\"><span>Product 1</span><span>Rp 50.00</span></div><div class=\"item\"><span>Product 2</span><span>Rp 30.00</span></div><div class=\"total item\"><span>Total</span><span>Rp 80.00</span></div><hr><div style=\"text-align: center; margin-top: 20px;\">Thank you!</div></body></html>",
        "cutPaper": true,
        "useExactLayout": true,
        "width": 576,
        "dither": true
      }
    },
    
    "mode2_data_simple": {
      "description": "Mode 2: Kirim data sederhana (sistem generate HTML)",
      "endpoint": "POST http://localhost:7080/api/print-html",
      "request": {
        "data": {
          "company": {
            "companyName": "DXN COMPANY",
            "address": "123 Main Street, Jakarta",
            "phone1": "123-456-7890",
            "email": "info@dxn.com"
          },
          "transHead": {
            "orderNo": "ORD001",
            "customerName": "John Doe",
            "cashier": "Cashier 1",
            "createdDate": "2024-01-01 10:00:00",
            "totalPrice": 80.00,
            "payAmt": 100.00,
            "change": 20.00,
            "paymentMethod": "Cash"
          },
          "transDetail": [
            {
              "seq": 1,
              "productName": "Product 1",
              "qty": 2,
              "price": 25.00,
              "sellingDesc": "Size: Large"
            },
            {
              "seq": 2,
              "productName": "Product 2",
              "qty": 1,
              "price": 30.00,
              "sellingDesc": "Size: Medium"
            }
          ],
          "printSetting": {
            "optType": "ORDER",
            "compName": true,
            "compAddr": true,
            "compPhone1": true,
            "compEmail": true,
            "orderNo": true,
            "custName": true,
            "cashier": true,
            "date": true,
            "salesPrice": true,
            "product": true,
            "sellingDesc": true,
            "paymentInfo": true,
            "footerMsg": true
          }
        },
        "cutPaper": true,
        "useExactLayout": true,
        "width": 576,
        "dither": true
      }
    },
    
