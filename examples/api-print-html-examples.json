    "mode2_data_minimal": {
      "description": "Mode 2: Data minimal (hanya field penting)",
      "endpoint": "POST http://localhost:7080/api/print-html",
      "request": {
        "data": {
          "company": {
            "companyName": "DXN COMPANY"
          },
          "transHead": {
            "orderNo": "ORD001",
            "totalPrice": 100.00,
            "createdDate": "2024-01-01 10:00:00"
          },
          "transDetail": [
            {
              "productName": "Product 1",
              "qty": 1,
              "price": 100.00
            }
          ],
