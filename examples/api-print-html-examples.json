    },
    
    "mode2_plain_text": {
      "description": "Mode 2: Generate HTML tapi print sebagai plain text (bukan exact layout)",
      "endpoint": "POST http://localhost:7080/api/print-html",
      "request": {
        "data": {
          "company": {
            "companyName": "DXN COMPANY",
            "address": "123 Main Street"
          },
          "transHead": {
            "orderNo": "ORD001",
            "totalPrice": 100.00
          },
          "transDetail": [
            {
              "productName": "Product 1",
              "qty": 1,
              "price": 100.00
            }
          ],
          "printSetting": {
            "compName": true,
            "compAddr": true,
            "orderNo": true,
            "salesPrice": true,
            "product": true
          }
        },
        "cutPaper": true,
        "useExactLayout": false
      }
    }
  },
  
  "notes": {
    "mode1": "Gunakan 'htmlContent' untuk kirim HTML langsung. Sistem akan print HTML yang sudah jadi.",
    "mode2": "Gunakan 'data' untuk kirim data. Sistem akan generate HTML dari data tersebut.",
    "parameters": {
      "cutPaper": "true = potong kertas setelah print, false = tidak potong (default: true)",
      "useExactLayout": "true = print dengan exact layout (sebagai gambar), false = print sebagai plain text (default: true)",
      "width": "Lebar bitmap dalam pixels untuk exact layout (default: 576 untuk printer 80mm)",
      "dither": "true = gunakan dithering untuk grayscale, false = tidak (default: true)"
    },
    "printSetting": "Field boolean di printSetting menentukan field mana yang akan ditampilkan. true = tampilkan, false/null = tidak tampilkan"
  }
}

